# SETFIT DARK RAGE Environment Variables
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=setfit-dark-rage-super-secret-key-2026-production
ADMIN_SECRET=SETFIT_MASTER_ADMIN_PASSCODE_2026

# PostgreSQL Database Connection URL:
# postgresql://username:password@localhost:5432/setfit_dark_rage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setfit_dark_rage

# Security Settings
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
